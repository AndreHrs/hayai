  async delete{{ModuleName}}(c: AuthContext) {
    const {{SECTION_PK_NAME}} = c.req.param("{{SECTION_PK_NAME}}");
    const existing = await prisma.{{moduleName}}.findUnique({ where: { {{SECTION_PK_JSON}}: {{SECTION_PK_NAME}} } });
    if (!existing) return this.fail(c, "{{ModuleName}} not found", 404);
    return this.execute(c, async () => {
      await prisma.{{moduleName}}.delete({ where: { {{SECTION_PK_JSON}}: {{SECTION_PK_NAME}} } });
      return { message: "{{ModuleName}} deleted successfully" };
    }, "{{ModuleName}} deleted successfully");
  }

