# JWT Configuration
JWT_SECRET=changeme
JWT_EXPIRATION=7d

# User Role Cache (in seconds, default: 3600 = 1 hour)
USER_CACHE=3600

# Password Configuration
SALT_ROUNDS=10

# Value between sqlite, postgresql, mysql
DATABASE_TYPE="postgresql"
# Database
DATABASE_URL="postgresql://username:password@localhost:5432/hayai"
# For sqlite, use:
# DATABASE_URL="file:./hayai.db"
# For MySQL, use:
# DATABASE_URL="mysql://username:password@localhost:3306/hayai-test"

PARALLEL_TEST=True
TEST_DATABASE_URL="postgresql://username:password@localhost:5432/hayai-test"
# For sqlite, use:
# TEST_DATABASE_URL="file:./hayai-test.db"
# For MySQL, use:
# TEST_DATABASE_URL="mysql://username:password@localhost:3306/hayai-test"

# Server
PORT=3000
NODE_ENV=development
