{
  "name": "@andre_hrs/hayai-cli",
  "version": "0.1.1",
  "description": "Fast Boilerplate & API Generator for Bun + Hono + Prisma",
  "author": "Andre Harsono andre_harsono@outlook.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndreHrs/hayai.git"
  },
  "bin": {
    "hayai": "./dist/hayai",
    "fast": "./dist/hayai"
  },
  "scripts": {
    "build": "bun build ./src/cli/index.ts --compile --outfile dist/hayai && bun run copy-templates",
    "copy-templates": "mkdir -p dist/templates && cp -r src/templates/* dist/templates/",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "hono": "^4.10.4"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "keywords": [
    "bun",
    "hono",
    "prisma",
    "cli",
    "code-generator",
    "boilerplate",
    "typescript"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "README.md",
    "package.json"
  ]
}